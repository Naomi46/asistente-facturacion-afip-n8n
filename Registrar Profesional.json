    {
      "parameters": {
        "html": "<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>Registro de Profesional</title>\n    <style>\n        /* Estilos Base */\n        body { margin: 0; padding: 20px; background: #f4f7f6; font-family: 'Segoe UI', Arial, sans-serif; display: flex; justify-content: center; align-items: flex-start; min-height: 100vh; }\n        .card { background: #ffffff; padding: 30px; border-radius: 16px; box-shadow: 0 8px 30px rgba(0,0,0,0.08); width: 100%; max-width: 500px; transition: all 0.3s ease; }\n        h2 { text-align: center; margin-top: 0; color: #1a1a1a; font-weight: 700; }\n        \n        /* Formulario */\n        label { font-size: 13px; display: block; margin-top: 15px; margin-bottom: 5px; color: #555; font-weight: 600; }\n        input, select { width: 100%; padding: 12px; border-radius: 10px; border: 1px solid #ddd; font-size: 14px; box-sizing: border-box; transition: border 0.3s; }\n        input:focus { outline: none; border-color: #007bff; box-shadow: 0 0 0 3px rgba(0,123,255,0.1); }\n        .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }\n\n        /* Botón y Spinner */\n        #btnSubmit { margin-top: 25px; width: 100%; padding: 14px; background: #007bff; color: white; border: none; border-radius: 10px; font-size: 16px; cursor: pointer; font-weight: bold; display: flex; justify-content: center; align-items: center; }\n        #btnSubmit:disabled { background: #a0c4ff; cursor: not-allowed; }\n\n        .loader {\n            border: 3px solid #f3f3f3;\n            border-top: 3px solid #ffffff;\n            border-radius: 50%;\n            width: 18px;\n            height: 18px;\n            animation: spin 1s linear infinite;\n            display: none; /* Oculto por defecto */\n            margin-left: 10px;\n        }\n\n        @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }\n\n        /* Pantalla de Éxito */\n        #success-container { display: none; text-align: center; padding: 20px; }\n        .icon-check { font-size: 60px; color: #28a745; margin-bottom: 20px; }\n        .btn-salir { background-color: #0088cc; color: white; border: none; padding: 14px; border-radius: 10px; font-weight: bold; font-size: 16px; cursor: pointer; margin-top: 20px; width: 100%; }\n    </style>\n</head>\n<body>\n\n    <div class=\"card\" id=\"form-container\">\n        <h2>Registro Fiscal</h2>\n        <form id=\"registroForm\">\n            <input type=\"hidden\" name=\"ID_Telegram\" value=\"{{ $json.query.id }}\" />\n\n            <div class=\"grid\">\n                <div><label>Nombre *</label><input type=\"text\" name=\"Nombre\" required /></div>\n                <div><label>Apellido *</label><input type=\"text\" name=\"Apellido\" required /></div>\n            </div>\n\n            <label>Razón Social *</label>\n            <input type=\"text\" name=\"RazonSocial\" placeholder=\"Ej: Juan Perez S.H.\" required />\n\n            <div class=\"grid\">\n                <div>\n                    <label>Categoría IVA *</label>\n                    <select name=\"CategoriaIVA\" required>\n                        <option value=\"\">Seleccione...</option>\n                        <option value=\"Responsable Inscripto\">Inscripto</option>\n                        <option value=\"Monotributista\">Monotributista</option>\n                        <option value=\"Exento\">Exento</option>\n                    </select>\n                </div>\n                <div><label>CUIT / DNI *</label><input type=\"text\" name=\"Cuit_profesional\" pattern=\"[0-9]{7,11}\" required /></div>\n            </div>\n\n            <div class=\"grid\">\n                <div><label>IIBB (Ingresos Brutos) *</label><input type=\"text\" name=\"iibb_profesional\" required /></div>\n                <div><label>Inicio Actividad *</label><input type=\"date\" name=\"Inicio_actividad\" required /></div>\n            </div>\n\n            <label>Contraseña Certificado AFIP *</label>\n            <input type=\"password\" name=\"Contrasena_Certificado\" required />\n\n            <div class=\"grid\">\n                <div><label>Carpeta *</label><input type=\"text\" name=\"Carpeta\" required /></div>\n                <div><label>Archivo *</label><input type=\"text\" name=\"Archivo\" required /></div>\n            </div>\n\n            <label>Punto de Venta *</label>\n            <input type=\"number\" name=\"Punto_venta\" min=\"1\" max=\"9999\" required />\n\n            <button type=\"submit\" id=\"btnSubmit\">\n                <span>Finalizar Registro</span>\n                <div class=\"loader\" id=\"loader\"></div>\n            </button>\n        </form>\n    </div>\n\n  <div class=\"card\" id=\"success-container\">\n        <div class=\"icon-check\">✅</div>\n        <h1>¡Registro Exitoso!</h1>\n        <p>Tus datos han sido procesados correctamente.<br><b>Muchas gracias por la paciencia.</b></p>\n        \n        <button id=\"btnFinalizar\" class=\"btn-salir\">Salir</button>\n    </div>\n\n   <script>\n        const form = document.getElementById('registroForm');\n        const formContainer = document.getElementById('form-container');\n        const successContainer = document.getElementById('success-container');\n        const btnFinalizar = document.getElementById('btnFinalizar');\n\n        // Función para salir con \"Plan B\"\n        btnFinalizar.addEventListener('click', function() {\n            // Intento 1: Cerrar la pestaña\n            window.close();\n            \n            // Intento 2: Volver atrás\n            window.history.back();\n\n            // Intento 3: Si 500ms después sigue acá, cambiamos el botón\n            setTimeout(() => {\n                btnFinalizar.innerText = \"Listo, ya podés cerrar esta pestaña\";\n                btnFinalizar.style.backgroundColor = \"#6c757d\"; // Gris\n            }, 500);\n        });\n\n        form.addEventListener('submit', function(e) {\n            e.preventDefault();\n            \n            const btnSubmit = document.getElementById('btnSubmit');\n            const loader = document.getElementById('loader');\n            \n            btnSubmit.disabled = true;\n            loader.style.display = \"inline-block\";\n\n            const formData = new FormData(form);\n            const data = Object.fromEntries(formData.entries());\n\n            // Envío de datos al Webhook de n8n\n            fetch('https://n8ntest.goodappsautomation.com/webhook/guardar-datos', {\n                method: 'POST',\n                headers: { 'Content-Type': 'application/json' },\n                body: JSON.stringify(data)\n            })\n            .then(() => {\n                formContainer.style.display = 'none';\n                successContainer.style.display = 'block';\n            })\n            .catch(error => {\n                alert('Hubo un error al guardar. Intentá de nuevo.');\n                btnSubmit.disabled = false;\n                loader.style.display = \"none\";\n            });\n        });\n    </script>\n</body>\n</html>"
      },
